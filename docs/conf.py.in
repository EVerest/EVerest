# Static pages generated by the staticpages extension. The versions index page
# is no longer rendered here — it is installed as a static, JS-driven page at
# the multiversion root by add-trailbook.cmake (templates/versions_index.html).
notfound_page = {
    'pagename': '404',
    'urls_prefix': '/latest/',
}

staticpages_pages = [
    notfound_page,
]
staticpages_urls_prefix = '/latest/'


# The EVerest API reference pages (reference/api/<name>.rst, rendered by the
# docs generator of the EVerest API client at build time) need their own
# stylesheet and script; no other page loads them.
API_REFERENCE_PREFIX = 'reference/api/'
API_REFERENCE_INDEX = 'reference/api/autogenerated_api_index'


def add_api_reference_assets(app, pagename, templatename, context, doctree):
    if pagename.startswith(API_REFERENCE_PREFIX) and pagename != API_REFERENCE_INDEX:
        app.add_css_file('everest-api/everest-api.css')
        app.add_js_file('everest-api/everest-api.js')


# Links to another API's page are written as <page>.html#<anchor>, the file
# layout of the html builder; this turns them into the URL of the builder in
# use (dirhtml: ../<page>/#<anchor>).
API_PAGE_LINK = re.compile(r'href="[^"#]*(#[^"]*)?" data-api-page="([^"]+)"')


def resolve_api_page_links(app, doctree, docname):
    if not docname.startswith(API_REFERENCE_PREFIX):
        return

    def href(match):
        target = posixpath.join(posixpath.dirname(docname), match.group(2))
        uri = app.builder.get_relative_uri(docname, target)
        return f'href="{uri}{match.group(1) or ""}" data-api-page="{match.group(2)}"'

    for node in doctree.findall(nodes.raw):
        if 'html' in node.get('format', '').split() and 'data-api-page=' in node.astext():
            node.replace(node[0], nodes.Text(API_PAGE_LINK.sub(href, node.astext())))


def setup(app):
    app.connect('html-page-context', add_api_reference_assets)
    app.connect('doctree-resolved', resolve_api_page_links)
