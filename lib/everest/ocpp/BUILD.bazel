load("@rules_cc//cc:defs.bzl", "cc_library")

exports_files(["config"])

# Mirrors the CMake configure_file step in lib/CMakeLists.txt that embeds the
# canonical NetworkConfiguration_1 schema into a generated translation unit so
# blob migration can bootstrap a per-slot component without a filesystem read.
genrule(
    name = "network_configuration_default_schema_cpp",
    srcs = [
        "lib/ocpp/v2/network_configuration_default_schema.cpp.in",
        "config/common/component_config/standardized/NetworkConfiguration_1.json",
    ],
    outs = ["generated/network_configuration_default_schema.cpp"],
    cmd = """python3 - "$(location lib/ocpp/v2/network_configuration_default_schema.cpp.in)" "$(location config/common/component_config/standardized/NetworkConfiguration_1.json)" "$@" <<'PYEOF'
import sys
tpl_path, json_path, out_path = sys.argv[1], sys.argv[2], sys.argv[3]
with open(tpl_path) as f:
    tpl = f.read()
with open(json_path) as f:
    js = f.read()
with open(out_path, 'w') as f:
    f.write(tpl.replace('@OCPP_NETWORK_CONFIGURATION_DEFAULT_SCHEMA_JSON@', js))
PYEOF
""",
    visibility = ["//visibility:private"],
)

genrule(
    name = "ocpp16_legacy_ctrlr_default_schema_cpp",
    srcs = [
        "lib/ocpp/v2/ocpp16_legacy_ctrlr_default_schema.cpp.in",
        "config/common/component_config/standardized/OCPP16LegacyCtrlr.json",
    ],
    outs = ["generated/ocpp16_legacy_ctrlr_default_schema.cpp"],
    cmd = """python3 - "$(location lib/ocpp/v2/ocpp16_legacy_ctrlr_default_schema.cpp.in)" "$(location config/common/component_config/standardized/OCPP16LegacyCtrlr.json)" "$@" <<'PYEOF'
import sys
tpl_path, json_path, out_path = sys.argv[1], sys.argv[2], sys.argv[3]
with open(tpl_path) as f:
    tpl = f.read()
with open(json_path) as f:
    js = f.read()
with open(out_path, 'w') as f:
    f.write(tpl.replace('@OCPP16_LEGACY_CTRLR_DEFAULT_SCHEMA_JSON@', js))
PYEOF
""",
    visibility = ["//visibility:private"],
)

cc_library(
    name = "websocketpp_utils",
    hdrs = glob([
        "3rd_party/websocketpp_utils/*.hpp",
    ]),
    includes = ["3rd_party"],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "libocpp",
    srcs = glob([
        "lib/ocpp/common/*.cpp",
        "lib/ocpp/common/database/*.cpp",
        "lib/ocpp/v16/*.cpp",
        "lib/ocpp/v2/*.cpp",
        "lib/ocpp/v2/functional_blocks/*.cpp",
        "lib/ocpp/v21/functional_blocks/*.cpp",
        "lib/ocpp/common/websocket/*.cpp",
        "lib/ocpp/v16/messages/*.cpp",
        "lib/ocpp/v2/messages/*.cpp",
        "lib/ocpp/v21/messages/*.cpp",
    ]) + [
        ":network_configuration_default_schema_cpp",
        ":ocpp16_legacy_ctrlr_default_schema_cpp",
    ],
    hdrs = glob([
        "include/**/*.hpp",
    ]),
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":websocketpp_utils",
        "//third-party/bazel/openssl:crypto",
        "//third-party/bazel/openssl:ssl",
        "@com_github_nlohmann_json//:json",
        "@com_github_HowardHinnant_date//:date",
        "//lib/everest/framework:framework",
        "//lib/everest/timer:libtimer",
        "//lib/everest/evse_security:libevse-security",
        "@com_github_pboettch_json-schema-validator//:json-schema-validator",
        "@com_github_warmcatt_libwebsockets//:libwebsockets",
        "//lib/everest/sqlite:everest-sqlite",
    ],
    copts = [
        "-std=c++17",
        "-Wimplicit-fallthrough",
        "-Wno-error=switch-enum",  # boost.date_time 1.87.0 has incomplete switch statements
    ],
    defines = [
        "LIBOCPP_ENABLE_V16=1",
        "LIBOCPP_ENABLE_V2=1",
        "MIGRATION_FILE_VERSION_V16={}".format(len(glob(["config/v16/core_migrations/*_up-*.sql"]))),
        "MIGRATION_FILE_VERSION_V2={}".format(len(glob(["config/v2/core_migrations/*_up-*.sql"]))),
        "MIGRATION_DEVICE_MODEL_FILE_VERSION_V2={}".format(len(glob(["config/common/device_model_migrations/*_up-*.sql"]))),
    ],
    # See https://github.com/HowardHinnant/date/issues/324
    local_defines = [
        "BUILD_TZ_LIB=ON",
        "USE_SYSTEM_TZ_DB=ON",
        "USE_OS_TZDB=1",
        "USE_AUTOLOAD=0",
        "HAS_REMOTE_API=0",
    ],
)

# Mirrors the install rules in config/v16/CMakeLists.txt and config/v2/CMakeLists.txt: the runtime files that
# OCPPmulti loads from share/everest/modules/OCPP (OCPP 1.6) and share/everest/modules/OCPP201 (OCPP 2.x).
_MODULE_SHARE_FILES = [
    (src, "share/everest/modules/OCPP/core_migrations/" + src.split("/")[-1])
    for src in glob(["config/v16/core_migrations/*.sql"])
] + [
    (src, "share/everest/modules/{}/device_model_migrations/{}".format(module, src.split("/")[-1]))
    for module in ["OCPP", "OCPP201"]
    for src in glob(["config/common/device_model_migrations/*.sql"])
] + [
    (src, "share/everest/modules/{}/component_config/standardized/{}".format(module, src.split("/")[-1]))
    for module in ["OCPP", "OCPP201"]
    for src in glob(["config/common/component_config/standardized/*.json"])
] + [
    (src, "share/everest/modules/OCPP/profile_schemas/" + src.split("/")[-1])
    for src in glob(
        ["config/v16/profile_schemas/*.json"],
        exclude = ["config/v16/profile_schemas/Custom.json"],
    )
] + [
    ("config/v16/" + name, "share/everest/modules/OCPP/" + name)
    for name in [
        "config.json",
        "config-docker.json",
        "config-docker-tls.json",
        "config-full.json",
        "ocpp16-custom-config-mappings.yaml",
    ]
] + [
    (src, "share/everest/modules/OCPP201/core_migrations/" + src.split("/")[-1])
    for src in glob(["config/v2/core_migrations/*.sql"])
] + [
    ("config/logging.ini", "share/everest/modules/{}/logging.ini".format(module))
    for module in ["OCPP", "OCPP201"]
]

genrule(
    name = "module_share_files",
    srcs = depset([src for src, _ in _MODULE_SHARE_FILES]).to_list(),
    outs = [dst for _, dst in _MODULE_SHARE_FILES] + [
        "share/everest/modules/OCPP201/component_config/custom/.gitkeep",
    ],
    cmd = " && ".join([
        "mkdir -p $$(dirname $(RULEDIR)/{dst}) && cp $(location {src}) $(RULEDIR)/{dst}".format(src = src, dst = dst)
        for src, dst in _MODULE_SHARE_FILES
    ] + [
        "mkdir -p $(RULEDIR)/share/everest/modules/OCPP201/component_config/custom",
        "touch $(RULEDIR)/share/everest/modules/OCPP201/component_config/custom/.gitkeep",
    ]),
    visibility = ["//visibility:public"],
)
