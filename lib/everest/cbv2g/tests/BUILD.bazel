    name = "test_utilities",
    srcs = ["test_utils/codec.cpp"],
    hdrs = ["test_utils/include/test_utils/codec.hpp"],
    includes = ["test_utils/include"],
    deps = [
        "//lib/everest/cbv2g:din",
        "//lib/everest/cbv2g:iso2",
        "//lib/everest/cbv2g:iso20",
    ],
)

