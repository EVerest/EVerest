load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//third-party/bazel/toolchains:defs.bzl", "CROSS_TEST_INCOMPATIBLE")

# Mirrors the CMake configure_file step that embeds the custom error mapping schema into a generated
# translation unit, so validation needs no installed file.
genrule(
    name = "custom_error_mapping_schema_cpp",
    srcs = [
        "src/custom_error_mapping_schema.cpp.in",
        "schemas/custom_error_mapping.schema.json",
    ],
    outs = ["generated/custom_error_mapping_schema.cpp"],
    cmd = """python3 - "$(location src/custom_error_mapping_schema.cpp.in)" "$(location schemas/custom_error_mapping.schema.json)" "$@" <<'PYEOF'
import sys
tpl_path, json_path, out_path = sys.argv[1], sys.argv[2], sys.argv[3]
with open(tpl_path) as f:
    tpl = f.read()
with open(json_path) as f:
    js = f.read()
with open(out_path, 'w') as f:
    f.write(tpl.replace('@CUSTOM_ERROR_MAPPING_SCHEMA_JSON@', js))
PYEOF
""",
    visibility = ["//visibility:private"],
)

cc_library(
    name = "ocpp_module_common",
    srcs = glob(["src/**/*.cpp"]) + [":custom_error_mapping_schema_cpp"],
    hdrs = glob(["include/**/*.hpp"]),
    copts = [
        "-std=c++17",
        "-Wimplicit-fallthrough",
        "-Wno-error=switch-enum",  # boost.date_time 1.87.0 has incomplete switch statements
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//interfaces:interfaces_lib",
        "//lib/everest/conversions/ocpp:ocpp_conversions",
        "//lib/everest/framework:framework",
        "//lib/everest/ocpp:libocpp",
        "//types:types_lib",
        "@com_github_pboettch_json-schema-validator//:json-schema-validator",
    ],
)

cc_test(
    name = "ocpp_module_common_tests",
    srcs = [
        "tests/custom_error_mapping_loader_tests.cpp",
        "tests/custom_error_mapping_validation_tests.cpp",
        "tests/custom_file_error_mapping_tests.cpp",
        "tests/error_handling_tests.cpp",
        "tests/transaction_handler_tests.cpp",
    ],
    data = glob(["tests/data/*.json"]) + ["schemas/custom_error_mapping.example.json"] + ["//errors"],
    linkstatic = True,
    local_defines = [
        'TEST_DATA_DIR=\\"lib/everest/ocpp_module_common/tests/data\\"',
        'CUSTOM_ERROR_MAPPING_SCHEMAS_DIR=\\"lib/everest/ocpp_module_common/schemas\\"',
        'EVEREST_ERRORS_DIR=\\"errors\\"',
    ],
    target_compatible_with = CROSS_TEST_INCOMPATIBLE,
    deps = [
        ":ocpp_module_common",
        "@com_github_nlohmann_json//:json",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
