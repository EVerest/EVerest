load("@rules_python//python:py_test.bzl", "py_test")
load("//third-party/bazel/toolchains:defs.bzl", "CROSS_PYTHON_INCOMPATIBLE")

# The Yocto build fetches the crates of the Rust modules itself, offline: the git crates
# at the revision the recipe names, patched into cargo, and the crates.io crates from the
# list generated out of Cargo.lock. Both must agree with the lock.
py_test(
    name = "rust_pins_test",
    size = "small",
    srcs = ["//applications/utils:scripts/check_rust_pins.py"],
    args = [
        "--crates-inc",
        "$(rootpath meta-everest-common/recipes-core/everest/everest-core-crates.inc)",
        "$(rootpath //modules:Cargo.lock)",
        "$(rootpath meta-everest-common/recipes-core/everest/everest-core-rust.inc)",
        "zvt",
        "zvt_feig_terminal",
    ],
    data = [
        "meta-everest-common/recipes-core/everest/everest-core-crates.inc",
        "meta-everest-common/recipes-core/everest/everest-core-rust.inc",
        "//modules:Cargo.lock",
    ],
    main = "//applications/utils:scripts/check_rust_pins.py",
    target_compatible_with = CROSS_PYTHON_INCOMPATIBLE,
)
