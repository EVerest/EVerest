{# Included by the module header and every implementation header. #}
{% if u.rwconfig %}
struct RwConf {
{% for item in u.rwconfig %}
    {{ config_type(item) }} {{ item.name }};
{% endfor %}
};

struct RwConfUpdate {
    using ConfigChangeResult = Everest::config::ConfigChangeResult;

    virtual ~RwConfUpdate() = default;

    // override in class {{ u.class_name }} adding the implementation to {{ u.class_name }}.cpp
    // or inline
    //
    // note: these handlers are invoked from a different thread than the one
    // executing your module code, so guard rw_config with a mutex both here
    // and wherever your module accesses config or rw_config
    // e.g.
    // ConfigChangeResult on_{{ u.rwconfig[0].name }}_changed(const {{ config_type(u.rwconfig[0]) }}& value) override {
    //     std::scoped_lock lock(config_mutex);
    //     rw_config.{{ u.rwconfig[0].name }} = value;
    //     return ConfigChangeResult::Accepted();
    // }

{% for item in u.rwconfig %}
    virtual ConfigChangeResult on_{{ item.name }}_changed(const {{ config_type(item) }}& /* value */) {
        return ConfigChangeResult::Rejected("handler not implemented");
    }
{% endfor %}
};
{% endif %}

struct Conf {
{% for item in u.config %}
    {{ config_type(item) }} {{ item.name }};
{% endfor %}

{% for item in u.rwconfig %}
    const {{ config_type(item) }}& {{ item.name }};
{% endfor %}

{% if u.rwconfig %}
    Conf(const RwConf& rw):
{% for item in u.rwconfig %}
        {{ item.name }}(rw.{{ item.name }}){{ ',' if not loop.last else ' {}' }}
{% endfor %}
{% endif %}
};
