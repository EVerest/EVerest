{% from "helper_macros.j2" import print_template_info, var_to_cpp, print_spdx_line %}
{{ print_spdx_line('Apache-2.0') }}
{{ print_template_info('6') }}

#include "{{ info.ld_ev_header }}"

#ifdef EVEREST_COVERAGE_ENABLED
#include <everest/helpers/coverage.hpp>
#endif

#include "{{ info.module_header }}"
{% for impl in provides %}
#include "{{ impl.class_header }}"
{% endfor %}

#include <framework/module_plugin.hpp>
#include <framework/runtime.hpp>
#include <utils/types.hpp>

#include <everest/project_info.hpp>

#include <memory>

{% if info.enable_global_errors %}
#include <utils/error/error_manager_req_global.hpp>

{% endif %}
namespace module {

// all state of one instance of this module; the declaration order is the construction order
class ModuleInstance final : public Everest::ModulePluginInstance {
public:
    Everest::ModuleAdapter adapter{};
    Everest::PtrContainer<{{ info.class_name }}> mod_ptr{};

    // per implementation configs
{% for impl in provides %}
{% if impl.rwconfig|length > 0 %}
    {{ impl.id }}::RwConf {{ impl.id }}_rwconfig{};
    {{ impl.id }}::Conf {{ impl.id }}_config{ {{- impl.id }}_rwconfig};
    // pointer to the concrete implementation, set in everest_register(), so config change
    // handlers can be registered without casting the module's base class pointer
    {{ impl.id }}::{{ impl.class_name }}* {{ impl.id }}_impl_p{nullptr};
{% else %}
    {{ impl.id }}::Conf {{ impl.id }}_config{};
{% endif %}
{% endfor %}
{% if info.module_rwconfig|length > 0 %}
    RwConf module_rwconf{};
    Conf module_conf{module_rwconf};
{% else %}
    Conf module_conf{};
{% endif %}
    ModuleInfo module_info{};

{% if info.enable_external_mqtt %}
    Everest::MqttProvider mqtt_provider{adapter};
{% endif %}
    Everest::TelemetryProvider telemetry_provider{adapter};

    // declared last so it is destroyed first, while everything it references still exists
    std::unique_ptr<{{ info.class_name }}> module;

    void register_module_adapter(Everest::ModuleAdapter module_adapter);
    std::vector<Everest::cmd> everest_register(const RequirementInitialization& requirement_init);

    Everest::ModuleCallbacks callbacks() override {
        return Everest::ModuleCallbacks(
            [this](Everest::ModuleAdapter module_adapter) { register_module_adapter(std::move(module_adapter)); },
            [this](const RequirementInitialization& requirement_init) { return everest_register(requirement_init); },
            [this](ModuleConfigs module_configs, const ModuleInfo& info) {
                LdEverest::init(*this, std::move(module_configs), info);
            },
            [this]() { LdEverest::ready(*this); }, [this]() { LdEverest::shutdown(*this); });
    }
};

namespace {
// The instance the framework entered last. Instances of one module are brought up sequentially, so free functions
// called during that bring-up resolve to the right instance. Calls from module-owned threads made after another
// instance was entered resolve to that other instance.
ModuleInstance* g_current_instance{nullptr};
} // namespace

ModuleInstance& default_instance() {
    static ModuleInstance instance;
    return instance;
}

ModuleInstance& current_instance() {
    if (g_current_instance != nullptr) {
        return *g_current_instance;
    }
    return default_instance();
}

{% if info.enable_global_errors %}
void subscribe_global_all_errors(
    const Everest::error::ErrorCallback& callback,
    const Everest::error::ErrorCallback& clear_callback
) {
    current_instance().adapter.get_global_error_manager()->subscribe_global_all_errors(callback, clear_callback);
}

std::shared_ptr<Everest::error::ErrorStateMonitor> get_global_error_state_monitor() {
    return current_instance().adapter.get_global_error_state_monitor();
}

{% endif %}
std::shared_ptr<Everest::config::ConfigServiceClient> get_config_service_client() {
    return current_instance().adapter.get_config_service_client();
}

void LdEverest::init(ModuleConfigs module_configs, const ModuleInfo& mod_info) {
    init(default_instance(), std::move(module_configs), mod_info);
}

void LdEverest::ready() {
    ready(default_instance());
}

void LdEverest::shutdown() {
    shutdown(default_instance());
}

void LdEverest::init(ModuleInstance& inst, ModuleConfigs module_configs, const ModuleInfo& mod_info) {
    using namespace Everest::config;

    g_current_instance = &inst;

    EVLOG_debug << "init() called on module {{ info.name }}";

    // populate config for provided implementations
    {% for impl in provides %}
    auto {{ impl.id }}_config_input = std::move(module_configs["{{ impl.id }}"]);
    {% for item in impl.config %}
    inst.{{ impl.id }}_config.{{ item.name }} = std::get<{{ item.cpp_type }}>({{ impl.id }}_config_input["{{ item.name }}"]);
    {% endfor %}
    {% for item in impl.rwconfig %}
    inst.{{ impl.id }}_rwconfig.{{ item.name }} = std::get<{{ item.cpp_type }}>({{ impl.id }}_config_input["{{ item.name }}"]);
    {% endfor %}
    {% endfor %}

    {% for item in info.module_config %}
    inst.module_conf.{{ item.name }} = std::get<{{ item.cpp_type }}>(module_configs["!module"]["{{ item.name }}"]);
    {% endfor %}
    {% for item in info.module_rwconfig %}
    inst.module_rwconf.{{ item.name }} = std::get<{{ item.cpp_type }}>(module_configs["!module"]["{{ item.name }}"]);
    {% endfor %}

    inst.module_info = mod_info;

    {% set config_client_was_created = namespace(value=false) %}

    {% for impl in provides %}
    {% for item in impl.rwconfig %}
    {% if loop.first %}
    // register runtime config change handlers for rw parameters for implementations
    {% if not config_client_was_created.value %}
    auto config_client = inst.adapter.get_config_service_client();
    {% set config_client_was_created.value = true %}
    {% endif %}
    if (config_client) {
    {% endif %}
        config_client->register_config_change_handler("{{ impl.id }}", "{{ item.name }}",
            [&inst](const std::string& new_value) -> Everest::config::ConfigChangeResult {
    {% if item.cpp_type == "std::string" %}
                return inst.{{ impl.id }}_impl_p->on_{{ item.name }}_changed(new_value);
    {% else %}
                {# fully qualified: a module-namespace "conversions" alias (e.g. in OCPP.hpp) would otherwise shadow the using-directive above #}
                const auto typed_value = Everest::config::conversions::ConfigFromString<{{ item.cpp_type }}>(new_value);
                return inst.{{ impl.id }}_impl_p->on_{{ item.name }}_changed(typed_value);
    {% endif %}
            });
    {% if loop.last %}
    }
    {% endif %}
    {% endfor %}
    {% endfor %}

    {% for item in info.module_rwconfig %}
    {% if loop.first %}
    {% if not config_client_was_created.value %}
    // register runtime config change handlers for rw parameters
    auto config_client = inst.adapter.get_config_service_client();
    {% endif %}
    if (config_client) {
    {% endif %}
        config_client->register_config_change_handler("!module", "{{ item.name }}",
            [&inst](const std::string& new_value) -> Everest::config::ConfigChangeResult {
    {% if item.cpp_type == "std::string" %}
                return inst.mod_ptr->on_{{ item.name }}_changed(new_value);
    {% else %}
                {# fully qualified: a module-namespace "conversions" alias (e.g. in OCPP.hpp) would otherwise shadow the using-directive above #}
                const auto typed_value = Everest::config::conversions::ConfigFromString<{{ item.cpp_type }}>(new_value);
                return inst.mod_ptr->on_{{ item.name }}_changed(typed_value);
    {% endif %}
            });
    {% if loop.last %}
    }
    {% endif %}
    {% endfor %}

    inst.mod_ptr->init();
}

void LdEverest::ready(ModuleInstance& inst) {
    g_current_instance = &inst;
    EVLOG_debug << "ready() called on module {{ info.name }}";
    inst.mod_ptr->ready();
}

void LdEverest::shutdown(ModuleInstance& inst) {
    g_current_instance = &inst;
    EVLOG_debug << "shutdown() called on module {{ info.name }}";
    inst.mod_ptr->shutdown();
}

void register_module_adapter(Everest::ModuleAdapter module_adapter) {
    default_instance().register_module_adapter(std::move(module_adapter));
}

std::vector<Everest::cmd> everest_register(const RequirementInitialization& requirement_init) {
    return default_instance().everest_register(requirement_init);
}

void ModuleInstance::register_module_adapter(Everest::ModuleAdapter module_adapter) {
    g_current_instance = this;
    adapter = std::move(module_adapter);
}

std::vector<Everest::cmd> ModuleInstance::everest_register(const RequirementInitialization& requirement_init) {
    g_current_instance = this;

    EVLOG_debug << "everest_register() called on module {{ info.name }}";

    adapter.check_complete();

    {% for impl in provides %}
    {% if impl.rwconfig|length > 0 %}
    auto p_{{ impl.id }} = std::make_unique<{{ impl.id }}::{{ impl.class_name }}>(&adapter, mod_ptr, {{ impl.id }}_config, {{ impl.id }}_rwconfig);
    {{ impl.id }}_impl_p = p_{{ impl.id }}.get();
    {% else %}
    auto p_{{ impl.id }} = std::make_unique<{{ impl.id }}::{{ impl.class_name }}>(&adapter, mod_ptr, {{ impl.id }}_config);
    {% endif %}
    adapter.gather_cmds(*p_{{ impl.id }});

    {% endfor %}
    {% for requirement in requires %}
    {# FIXME: needs refactoring #}
    {% if requirement.is_vector %}
    auto r_{{ requirement.id }} = std::vector<std::unique_ptr<{{ requirement.class_name }}>>();
    if (auto it = requirement_init.find("{{ requirement.id }}"); it != requirement_init.end()) {
        for (const auto& requirement_initializer : (*it).second) {
            auto requirement_module_id = requirement_initializer.fulfillment.module_id;
            auto requirement = requirement_initializer.requirement;
            auto mapping = requirement_initializer.mapping;
            r_{{ requirement.id }}.emplace_back(std::make_unique<{{ requirement.class_name }}>(&adapter, requirement, requirement_module_id, mapping));
        }
    }
    {% else %}
    std::string r_{{ requirement.id }}_requirement_module_id;
    Requirement r_{{ requirement.id }}_requirement;
    std::optional<Mapping> r_{{ requirement.id }}_mapping;
    if (auto it = requirement_init.find("{{ requirement.id }}"); it != requirement_init.end()) {
        auto requirement_initializer = (*it).second;
        if (requirement_initializer.size() > 0) {
            r_{{ requirement.id }}_requirement_module_id = requirement_initializer.at(0).fulfillment.module_id;
            r_{{ requirement.id }}_requirement = requirement_initializer.at(0).requirement;
            r_{{ requirement.id }}_mapping = requirement_initializer.at(0).mapping;
        }
    }
    auto r_{{ requirement.id }} = std::make_unique<{{ requirement.class_name }}>(&adapter, r_{{ requirement.id }}_requirement, r_{{ requirement.id }}_requirement_module_id, r_{{ requirement.id }}_mapping);
    {% endif %}
    {% else %}
        (void) requirement_init; // no requirements -> unused requirement initialization
    {% endfor %}

    module = std::make_unique<{{ info.class_name }}>(
    module_info,
    {%- if info.enable_external_mqtt %}mqtt_provider, {% endif -%}
    {%- if info.enable_telemetry %}telemetry_provider, {% endif -%}
    {%- for impl in provides -%}
    std::move(p_{{ impl.id }}){{ ', ' }}
    {%- endfor -%}
    {%- for requirement in requires -%}
    std::move(r_{{ requirement.id }}){{ ', ' }}
    {%- endfor -%}
    {% if info.module_rwconfig|length > 0 %}
    module_conf, module_rwconf);
    {% else %}
    module_conf);
    {% endif %}

    mod_ptr.set(module.get());

    return adapter.registered_commands;
}

} // namespace module

extern "C" const Everest::ModulePluginEntry* everest_module_entry() {
    static const Everest::ModulePluginEntry entry{
        Everest::MODULE_PLUGIN_ABI_VERSION, "{{ info.name }}",
        Everest::VersionInformation{std::string{everest::project_info::name()},
                                    std::string{everest::project_info::version()},
                                    std::string{everest::project_info::git_commit()}},
        []() -> std::unique_ptr<Everest::ModulePluginInstance> { return std::make_unique<module::ModuleInstance>(); }};
    return &entry;
}

#ifndef LD_EV_EXCLUDE_MAIN
int main(int argc, char* argv[]) {
#ifdef EVEREST_COVERAGE_ENABLED
    everest::helpers::install_signal_handlers_for_gcov();
#endif

    auto module_loader = Everest::ModuleLoader(argc, argv, module::default_instance().callbacks(),
        {std::string{everest::project_info::name()}, std::string{everest::project_info::version()},
         std::string{everest::project_info::git_commit()}});

    return module_loader.initialize();
}
#endif
