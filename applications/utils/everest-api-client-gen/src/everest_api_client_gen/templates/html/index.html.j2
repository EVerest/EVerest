{% import '_schema.html.j2' as schema with context %}
{% macro badge(action) %}
{% if action == 'send' %}
<span class="badge send" title="Published by the client, consumed by EVerest">send</span>
{% else %}
<span class="badge receive" title="Published by EVerest, consumed by the client">receive</span>
{% endif %}
{% endmacro %}
{% macro anchor(id) %}<a class="anchor" href="#{{ id }}" aria-label="Link to this section">¶</a>{% endmacro %}
{% macro experimental_tag() %}<span class="badge experimental" title="Exempt from the stability guarantees">experimental</span>{% endmacro %}
{% macro op_label(op) %}{{ op.title or op.op_id }}{% endmacro %}
{% macro operation(op) %}
<article class="op {{ op.action }}" id="op-{{ op.op_id }}" data-filter="{{ op.op_id }} {{ op.title }} {{ op.address or '' }} {{ op.message_ids | join(' ') }}">
<header class="op-head">
{{ badge(op.action) }}
{% if op.experimental %}{{ experimental_tag() }}{% endif %}
<h4>{{ op_label(op) }}</h4>
<code class="op-id">{{ op.op_id }}</code>
{{ anchor('op-' ~ op.op_id) }}
</header>
{% if op.experimental and not model.experimental %}
<p class="callout-inline">Experimental{% if op.experimental.since %} since {{ op.experimental.since }}{% endif %}: may change or be removed in any release without deprecation.{% if op.experimental.note %} {{ op.experimental.note }}{% endif %}</p>
{% endif %}
<dl class="op-facts">
{% if op.topic %}
<dt>Topic</dt>
<dd><code class="topic" data-copy="{{ op.topic }}">{{ op.topic }}</code></dd>
{% else %}
<dt>Topic</dt>
<dd>Dynamic: the <code>replyTo</code> address from the request's headers.
{% if op.request_op_id %}Answers <a href="#op-{{ op.request_op_id }}">{{ op.request_op_id }}</a>.{% endif %}</dd>
{% endif %}
{% if op.reply_location %}
<dt>Reply</dt>
<dd>Sent to <code>{{ op.reply_location }}</code>{% if op.reply_op_id %} as <a href="#op-{{ op.reply_op_id }}">{{ op.reply_op_id }}</a>{% endif %}.</dd>
{% endif %}
</dl>
{% if op.summary %}<div class="op-summary">{{ op.summary | md }}</div>{% endif %}
{% if op.description %}<div class="op-desc">{{ op.description | md }}</div>{% endif %}
{% for msg_id in op.message_ids %}
{% set msg = model.message(msg_id) %}
<details class="msg">
<summary><span class="msg-label">Message</span> <span class="msg-name">{{ msg.title or msg.name }}</span> <code class="ctype">{{ msg.content_type }}</code></summary>
<div class="msg-body">
{{ message_body(msg) }}
</div>
</details>
{% endfor %}
</article>
{% endmacro %}
{% macro message_body(msg) %}
<p class="msg-ref">Message <a href="#msg-{{ msg.msg_id }}"><code>{{ msg.name }}</code></a></p>
{% if msg.summary %}<div class="msg-summary">{{ msg.summary | md }}</div>{% endif %}
{% if msg.description %}<div class="msg-desc">{{ msg.description | md }}</div>{% endif %}
<div class="msg-grid">
<div>
<h5>Payload</h5>
{% if msg.payload %}
{{ schema.root(msg.payload) }}
{% else %}
<p class="s-note">No payload.</p>
{% endif %}
</div>
<div>
<h5>Example{% if msg.examples | length > 1 %}s{% endif %}</h5>
{% for ex in msg.examples %}
<figure class="example">
<figcaption>{{ ex.title }}{% if ex.generated %} <span class="tag">generated</span>{% endif %}</figcaption>
<pre data-copy-block><code>{{ ex.payload_json }}</code></pre>
</figure>
{% endfor %}
</div>
</div>
{% endmacro %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="generator" content="everest-api-client-gen">
<title>{{ model.name }} · EVerest API</title>
<link rel="stylesheet" href="{{ assets_href }}/everest-api.css">
<script defer src="{{ assets_href }}/everest-api.js"></script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="topbar">
<a class="home" href="../autogenerated_api_index.html">EVerest API reference</a>
<span class="crumb">{{ model.name }}</span>
{% if model.experimental %}{{ experimental_tag() }}{% endif %}
<span class="spacer"></span>
<button type="button" class="js-only width-toggle" data-width-toggle aria-pressed="false">Full width</button>
<button type="button" class="js-only theme-toggle" data-theme-toggle aria-label="Switch color theme">Theme: auto</button>
</header>
<div class="layout">
<nav class="sidebar" aria-label="Page contents">
<details class="nav-panel" open>
<summary>Contents</summary>
<input class="js-only filter" type="search" placeholder="Filter operations, messages, schemas" aria-label="Filter" data-filter-input>
<ol class="toc">
<li><a href="#overview">Overview</a></li>
<li><a href="#servers">Servers</a></li>
<li><a href="#operations">Operations <span class="count">{{ model.operations | length }}</span></a>
<ol>
{% for op in model.operations %}
<li data-filter="{{ op.op_id }} {{ op.title }} {{ op.address or '' }}"><a href="#op-{{ op.op_id }}"><span class="dot {{ op.action }}" aria-hidden="true"></span><span>{{ op.op_id | wordbreaks }}</span>{% if op.experimental %} <span class="tag">exp</span>{% endif %}</a></li>
{% endfor %}
</ol>
</li>
<li><a href="#messages">Messages <span class="count">{{ model.messages | length }}</span></a></li>
<li><a href="#schemas">Schemas <span class="count">{{ model.schemas | length }}</span></a>
<ol>
{% for node in model.schemas %}
<li data-filter="{{ node.name }}"><a href="#{{ schema_anchor(node.name) }}">{{ node.name }}</a></li>
{% endfor %}
{% for ref, node in model.imported_schemas %}
<li data-filter="{{ ref.name }} {{ ref.file_name }}"><a href="#{{ ref.anchor }}">{{ ref.name }} ↗</a></li>
{% endfor %}
</ol>
</li>
</ol>
</details>
</nav>
<main id="main">
<section id="overview" class="overview">
<h1>{{ model.title }}</h1>
{% if model.experimental %}
<aside class="callout warning" role="note">
<p class="callout-title">Experimental API{% if model.experimental.since %} <span class="muted">since {{ model.experimental.since }}</span>{% endif %}</p>
<p>This API is exempt from the EVerest stability guarantees and the deprecation period. Its channels, operations and message payloads may change or be removed in any release without notice until it is promoted to stable. See the <a href="../../../project/releases/deprecation-policy.html#project-experimental-components">policy on experimental components</a> and the <a href="../../../project/releases/experimental-index.html">experimental feature index</a>.</p>
{% if model.experimental.note %}<p>{{ model.experimental.note }}</p>{% endif %}
</aside>
{% endif %}
<div class="facts">
{% if model.version %}<span class="chip"><span class="s-label">version</span> {{ model.version }}</span>{% endif %}
<span class="chip"><span class="s-label">AsyncAPI</span> {{ model.asyncapi_version }}</span>
{% if model.default_content_type %}<span class="chip"><span class="s-label">content type</span> {{ model.default_content_type }}</span>{% endif %}
{% if model.license_name %}<span class="chip"><span class="s-label">license</span> {% if model.license_url %}<a href="{{ model.license_url }}">{{ model.license_name }}</a>{% else %}{{ model.license_name }}{% endif %}</span>{% endif %}
{% for tag in model.tags %}<span class="chip tag">{{ tag }}</span>{% endfor %}
</div>
{% if model.description %}<div class="lead">{{ model.description | md }}</div>{% endif %}
<p class="spec-file">Specification: <code>{{ model.name }}.yaml</code>{% if model.spec_id %} · <code>{{ model.spec_id }}</code>{% endif %}</p>
<div class="legend">
<span>{{ badge('send') }} the client publishes, EVerest consumes ({{ model.send_operations | length }})</span>
<span>{{ badge('receive') }} EVerest publishes, the client consumes ({{ model.receive_operations | length }})</span>
</div>
</section>

<section id="servers">
<div class="section-head"><h2>Servers {{ anchor('servers') }}</h2><span class="section-count">{{ model.servers | length }}</span></div>
{% for srv in model.servers %}
<div class="card server" id="server-{{ srv.name }}">
<h3>{{ srv.name }} {% if srv.protocol %}<span class="chip">{{ srv.protocol }}</span>{% endif %}</h3>
{% if srv.description %}<div>{{ srv.description | md }}</div>{% endif %}
<dl class="op-facts">
{% if srv.host %}<dt>Host</dt><dd><code>{{ srv.host }}</code></dd>{% endif %}
<dt>Topic prefix</dt><dd><code class="topic" data-copy="{{ srv.pathname }}">{{ srv.pathname }}</code></dd>
{% for var, desc in srv.variables %}
<dt><code>{{ '{' ~ var ~ '}' }}</code></dt><dd>{{ desc | md }}</dd>
{% endfor %}
</dl>
</div>
{% else %}
<p class="s-note">No servers defined.</p>
{% endfor %}
</section>

<section id="operations">
<div class="section-head">
<h2>Operations {{ anchor('operations') }}</h2><span class="section-count">{{ model.operations | length }}</span>
<div class="js-only toolbar">
<button type="button" data-expand="all">Expand all</button>
<button type="button" data-expand="none">Collapse all</button>
</div>
</div>
{% for action, title in [('send', 'client to EVerest'), ('receive', 'EVerest to client')] %}
{% set ops = model.send_operations if action == 'send' else model.receive_operations %}
{% if ops %}
<h3 class="group {{ action }}">{{ badge(action) }} {{ title }} <span class="count">{{ ops | length }}</span></h3>
{% for op in ops %}
{{ operation(op) }}
{% endfor %}
{% endif %}
{% endfor %}
</section>

<section id="messages">
<div class="section-head"><h2>Messages {{ anchor('messages') }}</h2><span class="section-count">{{ model.messages | length }}</span></div>
<div class="table-wrap">
<table class="messages">
<thead><tr><th>Message</th><th>Summary</th><th>Used by</th></tr></thead>
<tbody>
{% for msg in model.messages %}
<tr id="msg-{{ msg.msg_id }}" data-filter="{{ msg.msg_id }} {{ msg.name }} {{ msg.title }}">
<td><code>{{ msg.name }}</code>{% if msg.title %}<br><span class="muted">{{ msg.title }}</span>{% endif %}</td>
<td>{{ msg.summary | md }}</td>
<td>{% for op_id in msg.used_by %}<a href="#op-{{ op_id }}">{{ op_id }}</a>{% if not loop.last %}<br>{% endif %}{% else %}<span class="muted">not used by an operation</span>{% endfor %}</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
{% for msg in model.messages if not msg.used_by %}
<details class="msg" id="msg-detail-{{ msg.msg_id }}">
<summary><span class="msg-label">Message</span> <span class="msg-name">{{ msg.title or msg.name }}</span> <code class="ctype">{{ msg.content_type }}</code></summary>
<div class="msg-body">{{ message_body(msg) }}</div>
</details>
{% endfor %}
</section>

<section id="schemas">
<div class="section-head"><h2>Schemas {{ anchor('schemas') }}</h2><span class="section-count">{{ model.schemas | length + model.imported_schemas | length }}</span></div>
{% for node in model.schemas %}
<details class="schema" id="{{ schema_anchor(node.name) }}" data-filter="{{ node.name }}">
<summary><span class="s-name">{{ node.name }}</span> <span class="s-type">{{ node.type }}</span>{{ anchor(schema_anchor(node.name)) }}</summary>
{{ schema.root(node) }}
</details>
{% endfor %}
{% if model.imported_schemas %}
<h3 class="group" id="imported-schemas">Schemas from other APIs {{ anchor('imported-schemas') }}</h3>
{% for ref, node in model.imported_schemas %}
<details class="schema" id="{{ ref.anchor }}" data-filter="{{ ref.name }} {{ ref.file_name }}">
<summary><span class="s-name">{{ ref.name }}</span> <span class="s-type">{{ node.type }}</span> <a class="s-ref" href="{{ ref.href }}">defined in {{ ref.file_name }} ↗</a>{{ anchor(ref.anchor) }}</summary>
{{ schema.root(node) }}
</details>
{% endfor %}
{% endif %}
</section>
</main>
</div>
</body>
</html>
