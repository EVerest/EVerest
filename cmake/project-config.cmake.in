include_guard(GLOBAL)

set(@LIBRARY_PACKAGE_NAME@_VERSION @PROJECT_VERSION@)

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(EVEREST_CORE_DATADIR "@PACKAGE_EVEREST_DATADIR@")
set(EVEREST_SCHEMA_DIR "${EVEREST_CORE_DATADIR}/schemas")
set(EV_PROJECT_INFO_SOURCE_DIR "${EVEREST_CORE_DATADIR}/project_info")
find_dependency(everest-base REQUIRED)
find_dependency(Boost REQUIRED COMPONENTS filesystem program_options thread headers)
find_dependency(date REQUIRED)
find_dependency(nlohmann_json REQUIRED)
find_dependency(nlohmann_json_schema_validator REQUIRED)
find_dependency(ryml REQUIRED)
find_dependency(fmt REQUIRED)
find_dependency(Threads REQUIRED)
find_dependency(sdbus-c++ REQUIRED)

include(${CMAKE_CURRENT_LIST_DIR}/ev-project-bootstrap.cmake)

include(${CMAKE_CURRENT_LIST_DIR}/everest-core-targets.cmake)

ev_add_project(
    EV_PROJECT_DIRECTORY ${EVEREST_CORE_DATADIR}
    EV_PROJECT_NAME everest-core
    SKIP_DOC_GENERATION
)
