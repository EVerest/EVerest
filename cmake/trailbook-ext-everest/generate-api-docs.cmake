# This function generates the HTML reference of the EVerest API (AsyncAPI)
# specs with the docs generator of the EVerest API client package, run
# straight from the source tree (it needs only jinja2 and pyyaml).
#
# One command renders everything into the trailbook instance source directory:
# the RST index page reference/api/autogenerated_api_index.rst, which the
# reference toctree lists, and the pages with their shared assets below
# _extra/reference/api/, which Sphinx copies into the site as they are
# (html_extra_path in docs/conf.py.in). The pages are served at
# reference/api/<name>/index.html next to reference/api/_assets/.
#
# Arguments:
#   TRAILBOOK_NAME (required): Name of the trailbook instance.
#   API_FILES (required): The AsyncAPI spec files, all in one directory.
# Usage:
# trailbook_ev_generate_api_doc(
#     TRAILBOOK_NAME <trailbook_name>
#     API_FILES <spec_file>...
# )
function(trailbook_ev_generate_api_doc)
    set(options)
    set(one_value_args
        TRAILBOOK_NAME
    )
    set(multi_value_args
        API_FILES
    )
    cmake_parse_arguments(
        "args"
        "${options}"
        "${one_value_args}"
        "${multi_value_args}"
        ${ARGN}
    )

    if(NOT args_TRAILBOOK_NAME)
        message(FATAL_ERROR "trailbook_ev_generate_api_doc: TRAILBOOK_NAME argument is required")
    endif()
    if(NOT TARGET trailbook_${args_TRAILBOOK_NAME})
        message(
            FATAL_ERROR
            "trailbook_ev_generate_api_doc: No target named trailbook_${args_TRAILBOOK_NAME} found."
            " Did you forget to call add_trailbook() first?"
        )
    endif()
    if(NOT args_API_FILES)
        message(FATAL_ERROR "trailbook_ev_generate_api_doc: API_FILES argument is required")
    endif()

    get_target_property(
        TRAILBOOK_INSTANCE_SOURCE_DIRECTORY
        trailbook_${args_TRAILBOOK_NAME}
        TRAILBOOK_INSTANCE_SOURCE_DIRECTORY
    )

    get_filename_component(
        GENERATOR_SOURCE_DIRECTORY
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../applications/utils/everest-api-client"
        ABSOLUTE
    )
    # Regenerate when the generator's code, templates or assets change.
    file(GLOB_RECURSE GENERATOR_FILES CONFIGURE_DEPENDS
        "${GENERATOR_SOURCE_DIRECTORY}/everest_api/*.py"
        "${GENERATOR_SOURCE_DIRECTORY}/everest_api/templates/html/*"
    )

    set(INDEX_RST_FILE "${TRAILBOOK_INSTANCE_SOURCE_DIRECTORY}/reference/api/autogenerated_api_index.rst")
    set(HTML_DIRECTORY "${TRAILBOOK_INSTANCE_SOURCE_DIRECTORY}/_extra/reference/api")

    add_custom_command(
        OUTPUT
            ${INDEX_RST_FILE}
        DEPENDS
            ${args_API_FILES}
            ${GENERATOR_FILES}
        COMMENT
            "Generating the EVerest API reference (HTML pages and RST index)"
        COMMAND
            ${CMAKE_COMMAND} -E env "PYTHONPATH=${GENERATOR_SOURCE_DIRECTORY}"
            ${Python3_EXECUTABLE} -m everest_api.docs_cli
            --spec ${args_API_FILES}
            --html-out "${HTML_DIRECTORY}"
            --index-out "${INDEX_RST_FILE}"
    )
    add_custom_target(
        trailbook_${args_TRAILBOOK_NAME}_generate_api_doc
        DEPENDS
            ${INDEX_RST_FILE}
        COMMENT
            "Target to generate the EVerest API reference in ${TRAILBOOK_INSTANCE_SOURCE_DIRECTORY}"
    )
    set_property(
        TARGET
            trailbook_${args_TRAILBOOK_NAME}
        APPEND
        PROPERTY
            ADDITIONAL_DEPS_STAGE_BUILD_SPHINX_BEFORE
                ${INDEX_RST_FILE}
                trailbook_${args_TRAILBOOK_NAME}_generate_api_doc
    )
    _trailbook_ev_register_generated_files(
        TRAILBOOK_NAME ${args_TRAILBOOK_NAME}
        FILES ${INDEX_RST_FILE} ${HTML_DIRECTORY}
    )
endfunction()
