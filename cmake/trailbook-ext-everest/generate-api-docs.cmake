# This function generates the reference of the EVerest API (AsyncAPI) specs
# with the docs generator of the EVerest API client package, run straight from
# the source tree (it needs jinja2, pyyaml and jsonschema).
#
# One command validates every spec against the AsyncAPI 3.0 schema and renders
# everything into the trailbook instance source directory: a Sphinx page
# reference/EVerestAPI/<name>.rst per spec, the index page
# reference/EVerestAPI/autogenerated_api_index.rst listing them in its
# toctree, which the reference toctree lists, and the stylesheet and script of
# the pages in _static/everest-api/. The directory is kept apart from
# reference/EVerest_API/, where the stem copy puts the specs themselves. docs/conf.py.in adds those two to the API pages only.
# The generator leaves unchanged files untouched, so Sphinx reads only the
# pages that changed; the rendered files are therefore byproducts and a stamp
# is the output. A page whose spec is gone is removed at configure time.
#
# Arguments:
#   TRAILBOOK_NAME (required): Name of the trailbook instance.
#   API_FILES (required): The AsyncAPI spec files, all in one directory.
# Usage:
# trailbook_ev_generate_api_doc(
#     TRAILBOOK_NAME <trailbook_name>
#     API_FILES <spec_file>...
# )
function(trailbook_ev_generate_api_doc)
    cmake_parse_arguments("args" "" "TRAILBOOK_NAME" "API_FILES" ${ARGN})
    _trailbook_ev_require_trailbook(${CMAKE_CURRENT_FUNCTION} "${args_TRAILBOOK_NAME}")
    if(NOT args_API_FILES)
        message(FATAL_ERROR "${CMAKE_CURRENT_FUNCTION}: API_FILES argument is required")
    endif()

    get_target_property(
        TRAILBOOK_INSTANCE_SOURCE_DIRECTORY
        trailbook_${args_TRAILBOOK_NAME}
        TRAILBOOK_INSTANCE_SOURCE_DIRECTORY
    )
    get_target_property(
        TRAILBOOK_CURRENT_BINARY_DIR
        trailbook_${args_TRAILBOOK_NAME}
        TRAILBOOK_CURRENT_BINARY_DIR
    )
    get_filename_component(
        GENERATOR_SOURCE_DIRECTORY
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../applications/utils/everest-api-client"
        ABSOLUTE
    )
    # Regenerate when the generator changes: the modules docs_cli imports
    # (not the interactive client next to them), the AsyncAPI schema, the
    # templates and the assets.
    set(GENERATOR_FILES
        "${GENERATOR_SOURCE_DIRECTORY}/everest_api/docs_cli.py"
        "${GENERATOR_SOURCE_DIRECTORY}/everest_api/docs_generator.py"
        "${GENERATOR_SOURCE_DIRECTORY}/everest_api/doc_model.py"
        "${GENERATOR_SOURCE_DIRECTORY}/everest_api/spec_loader.py"
        "${GENERATOR_SOURCE_DIRECTORY}/everest_api/schemas/asyncapi-3.0.0.json"
    )
    file(GLOB_RECURSE GENERATOR_TEMPLATE_FILES CONFIGURE_DEPENDS
        "${GENERATOR_SOURCE_DIRECTORY}/everest_api/templates/rst/*"
    )
    set(RST_DIRECTORY "${TRAILBOOK_INSTANCE_SOURCE_DIRECTORY}/reference/EVerestAPI")
    set(ASSETS_DIRECTORY "${TRAILBOOK_INSTANCE_SOURCE_DIRECTORY}/_static/everest-api")

    set(GENERATED_FILES "${RST_DIRECTORY}/autogenerated_api_index.rst")
    foreach(API_FILE IN LISTS args_API_FILES)
        get_filename_component(API_NAME "${API_FILE}" NAME_WE)
        list(APPEND GENERATED_FILES "${RST_DIRECTORY}/${API_NAME}.rst")
    endforeach()
    # ASSET_FILES in everest_api/docs_generator.py
    list(APPEND GENERATED_FILES
        "${ASSETS_DIRECTORY}/everest-api.css"
        "${ASSETS_DIRECTORY}/everest-api.js"
    )

    # Next to the instance source directory, so the two are deleted together.
    # A missing byproduct does not make the Makefile generator rerun the
    # command, so a stamp outliving one of the pages is dropped here.
    set(STAMP_FILE "${TRAILBOOK_CURRENT_BINARY_DIR}/generate_api_doc.check_done")
    foreach(GENERATED_FILE IN LISTS GENERATED_FILES)
        if(NOT EXISTS "${GENERATED_FILE}")
            file(REMOVE "${STAMP_FILE}")
            break()
        endif()
    endforeach()
    add_custom_command(
        OUTPUT
            ${STAMP_FILE}
        BYPRODUCTS
            ${GENERATED_FILES}
        DEPENDS
            ${args_API_FILES}
            ${GENERATOR_FILES}
            ${GENERATOR_TEMPLATE_FILES}
        COMMENT
            "Generating the EVerest API reference pages"
        COMMAND
            ${CMAKE_COMMAND} -E env "PYTHONPATH=${GENERATOR_SOURCE_DIRECTORY}"
            ${Python3_EXECUTABLE} -m everest_api.docs_cli
            --spec ${args_API_FILES}
            --rst-out "${RST_DIRECTORY}"
            --assets-out "${ASSETS_DIRECTORY}"
        COMMAND
            ${CMAKE_COMMAND} -E touch "${STAMP_FILE}"
    )
    _trailbook_ev_add_generated(
        TRAILBOOK_NAME ${args_TRAILBOOK_NAME}
        TARGET trailbook_${args_TRAILBOOK_NAME}_generate_api_doc
        FILES ${GENERATED_FILES}
        STAMP "${STAMP_FILE}"
    )
endfunction()

# This function stands in for trailbook_ev_generate_api_doc when the API
# reference is left out (EVEREST_SKIP_BUILD_API_DOC): it writes a page in
# place of reference/EVerestAPI/autogenerated_api_index.rst saying so, since the
# reference toctree and several :doc: links name that document.
#
# Arguments:
#   TRAILBOOK_NAME (required): Name of the trailbook instance.
# Usage:
# trailbook_ev_generate_api_doc_stub(
#     TRAILBOOK_NAME <trailbook_name>
# )
function(trailbook_ev_generate_api_doc_stub)
    cmake_parse_arguments("args" "" "TRAILBOOK_NAME" "" ${ARGN})
    _trailbook_ev_require_trailbook(${CMAKE_CURRENT_FUNCTION} "${args_TRAILBOOK_NAME}")

    get_target_property(
        TRAILBOOK_INSTANCE_SOURCE_DIRECTORY
        trailbook_${args_TRAILBOOK_NAME}
        TRAILBOOK_INSTANCE_SOURCE_DIRECTORY
    )
    set(INDEX_RST_FILE "${TRAILBOOK_INSTANCE_SOURCE_DIRECTORY}/reference/EVerestAPI/autogenerated_api_index.rst")
    # written only when its content differs, so the site is not rebuilt for it
    configure_file(
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/templates/api_index_skipped.rst"
        "${INDEX_RST_FILE}"
        COPYONLY
    )
    _trailbook_ev_register_generated_files(
        TRAILBOOK_NAME ${args_TRAILBOOK_NAME}
        FILES ${INDEX_RST_FILE}
    )
    set_property(
        TARGET
            trailbook_${args_TRAILBOOK_NAME}
        APPEND
        PROPERTY
            ADDITIONAL_DEPS_STAGE_BUILD_SPHINX_BEFORE
                ${INDEX_RST_FILE}
    )
endfunction()
