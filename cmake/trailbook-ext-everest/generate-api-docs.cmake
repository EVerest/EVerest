# This function generates the HTML reference of the EVerest API (AsyncAPI)
# specs with the docs generator of the EVerest API client package, run
# straight from the source tree (it needs jinja2, pyyaml and jsonschema).
#
# One command validates every spec against the AsyncAPI 3.0 schema and
# renders everything into the trailbook instance source directory: the RST
# index page reference/api/autogenerated_api_index.rst, which the reference
# toctree lists, and the pages with their shared assets below
# _extra/reference/api/, which Sphinx copies into the site as they are
# (html_extra_path in docs/conf.py.in). The pages are served at
# reference/api/<name>/index.html next to reference/api/_assets/. Every
# rendered file is an output of that command and a dependency of the Sphinx
# stage. Ninja regenerates a missing one; the Makefile generator only when
# an input changes or the index RST is removed.
#
# Arguments:
#   TRAILBOOK_NAME (required): Name of the trailbook instance.
#   API_FILES (required): The AsyncAPI spec files, all in one directory.
# Usage:
# trailbook_ev_generate_api_doc(
#     TRAILBOOK_NAME <trailbook_name>
#     API_FILES <spec_file>...
# )
function(trailbook_ev_generate_api_doc)
    cmake_parse_arguments("args" "" "TRAILBOOK_NAME" "API_FILES" ${ARGN})
    _trailbook_ev_require_trailbook(${CMAKE_CURRENT_FUNCTION} "${args_TRAILBOOK_NAME}")
    if(NOT args_API_FILES)
        message(FATAL_ERROR "${CMAKE_CURRENT_FUNCTION}: API_FILES argument is required")
    endif()

    get_target_property(
        TRAILBOOK_INSTANCE_SOURCE_DIRECTORY
        trailbook_${args_TRAILBOOK_NAME}
        TRAILBOOK_INSTANCE_SOURCE_DIRECTORY
    )
    get_filename_component(
        GENERATOR_SOURCE_DIRECTORY
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../applications/utils/everest-api-client"
        ABSOLUTE
    )
    # Regenerate when the generator changes: the modules docs_cli imports
    # (not the interactive client next to them), the AsyncAPI schema, the
    # templates and the assets.
    set(GENERATOR_FILES
        "${GENERATOR_SOURCE_DIRECTORY}/everest_api/docs_cli.py"
        "${GENERATOR_SOURCE_DIRECTORY}/everest_api/docs_generator.py"
        "${GENERATOR_SOURCE_DIRECTORY}/everest_api/doc_model.py"
        "${GENERATOR_SOURCE_DIRECTORY}/everest_api/spec_loader.py"
        "${GENERATOR_SOURCE_DIRECTORY}/everest_api/schemas/asyncapi-3.0.0.json"
    )
    file(GLOB_RECURSE GENERATOR_TEMPLATE_FILES CONFIGURE_DEPENDS
        "${GENERATOR_SOURCE_DIRECTORY}/everest_api/templates/html/*"
    )
    set(INDEX_RST_FILE "${TRAILBOOK_INSTANCE_SOURCE_DIRECTORY}/reference/api/autogenerated_api_index.rst")
    set(HTML_DIRECTORY "${TRAILBOOK_INSTANCE_SOURCE_DIRECTORY}/_extra/reference/api")

    set(GENERATED_PAGES "")
    foreach(API_FILE IN LISTS args_API_FILES)
        get_filename_component(API_NAME "${API_FILE}" NAME_WE)
        list(APPEND GENERATED_PAGES "${HTML_DIRECTORY}/${API_NAME}/index.html")
    endforeach()
    # ASSET_FILES in everest_api/docs_generator.py
    set(GENERATED_ASSETS
        "${HTML_DIRECTORY}/_assets/everest-api.css"
        "${HTML_DIRECTORY}/_assets/everest-api.js"
    )

    add_custom_command(
        OUTPUT
            ${INDEX_RST_FILE}
            ${GENERATED_PAGES}
            ${GENERATED_ASSETS}
        DEPENDS
            ${args_API_FILES}
            ${GENERATOR_FILES}
            ${GENERATOR_TEMPLATE_FILES}
        COMMENT
            "Generating the EVerest API reference (HTML pages and RST index)"
        COMMAND
            ${CMAKE_COMMAND} -E env "PYTHONPATH=${GENERATOR_SOURCE_DIRECTORY}"
            ${Python3_EXECUTABLE} -m everest_api.docs_cli
            --spec ${args_API_FILES}
            --html-out "${HTML_DIRECTORY}"
            --index-out "${INDEX_RST_FILE}"
    )
    _trailbook_ev_add_generated(
        TRAILBOOK_NAME ${args_TRAILBOOK_NAME}
        TARGET trailbook_${args_TRAILBOOK_NAME}_generate_api_doc
        FILES ${INDEX_RST_FILE} ${GENERATED_PAGES} ${GENERATED_ASSETS}
    )
    # the page directory goes with the index when the API docs are dropped
    _trailbook_ev_register_generated_files(
        TRAILBOOK_NAME ${args_TRAILBOOK_NAME}
        FILES ${HTML_DIRECTORY}
    )
endfunction()

# This function stands in for trailbook_ev_generate_api_doc when the API
# reference is left out (EVEREST_SKIP_BUILD_API_DOC): it writes a page in
# place of reference/api/autogenerated_api_index.rst saying so, since the
# reference toctree and several :doc: links name that document.
#
# Arguments:
#   TRAILBOOK_NAME (required): Name of the trailbook instance.
# Usage:
# trailbook_ev_generate_api_doc_stub(
#     TRAILBOOK_NAME <trailbook_name>
# )
function(trailbook_ev_generate_api_doc_stub)
    cmake_parse_arguments("args" "" "TRAILBOOK_NAME" "" ${ARGN})
    _trailbook_ev_require_trailbook(${CMAKE_CURRENT_FUNCTION} "${args_TRAILBOOK_NAME}")

    get_target_property(
        TRAILBOOK_INSTANCE_SOURCE_DIRECTORY
        trailbook_${args_TRAILBOOK_NAME}
        TRAILBOOK_INSTANCE_SOURCE_DIRECTORY
    )
    set(INDEX_RST_FILE "${TRAILBOOK_INSTANCE_SOURCE_DIRECTORY}/reference/api/autogenerated_api_index.rst")
    # written only when its content differs, so the site is not rebuilt for it
    configure_file(
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/templates/api_index_skipped.rst"
        "${INDEX_RST_FILE}"
        COPYONLY
    )
    _trailbook_ev_register_generated_files(
        TRAILBOOK_NAME ${args_TRAILBOOK_NAME}
        FILES ${INDEX_RST_FILE}
    )
    set_property(
        TARGET
            trailbook_${args_TRAILBOOK_NAME}
        APPEND
        PROPERTY
            ADDITIONAL_DEPS_STAGE_BUILD_SPHINX_BEFORE
                ${INDEX_RST_FILE}
    )
endfunction()
